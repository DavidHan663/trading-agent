FROM python:3.12-slim AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /build
COPY pyproject.toml README.md LICENSE requirements-web.lock ./
COPY tradingagents ./tradingagents
COPY cli ./cli
RUN pip install --no-cache-dir -r requirements-web.lock \
    && pip install --no-cache-dir --no-deps ".[web]"

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" TRADINGAGENTS_WEB_HOST=0.0.0.0
RUN useradd --create-home --uid 10001 appuser \
    && install -d -m 0700 -o appuser -g appuser /home/appuser/.tradingagents
COPY --from=builder /opt/venv /opt/venv
USER appuser
WORKDIR /home/appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"
CMD ["tradingagents-web"]
