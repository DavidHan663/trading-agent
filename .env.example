# Copy to .env; never put real credentials in this template.
TRADINGAGENTS_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
TRADINGAGENTS_LLM_BACKEND_URL=https://api.deepseek.com
# Set model IDs available to your provider account.
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-flash
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-flash
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_LLM_MAX_RETRIES=2
TRADINGAGENTS_MAX_TOKENS=8192

# Alternative providers: choose the provider and fill its key as needed.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
#TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:8000/v1
#OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional data sources (yfinance is the default).
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Only required for manual web / Docker startup. The local launcher generates
# its own random password and stores it under .local-web/.
TRADINGAGENTS_WEB_USER=admin
TRADINGAGENTS_WEB_PASSWORD=
TRADINGAGENTS_WEB_JOB_TIMEOUT=1800
TRADINGAGENTS_DOMAIN=localhost
